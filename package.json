{
  "name": "ae-assistant",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "AE Assistant — CEP-панель для Adobe After Effects: ИИ-чат и быстрые действия",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:host": "node scripts/check-host.mjs",
    "build": "tsc --noEmit && node scripts/check-host.mjs && vite build && node scripts/assemble.mjs",
    "install:dev": "node scripts/install-dev.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
